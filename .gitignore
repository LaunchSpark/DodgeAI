__pycache__/
*.pyc
.pytest_cache/
# Keep generated artifacts ignored, with selected shareable models below.
artifacts/*
!artifacts/models/
artifacts/models/*
!artifacts/models/README.md
!artifacts/models/can-reach-100.zip
!artifacts/models/velocity-flow-v2.zip
!artifacts/models/velocity-flow-v2-latest.zip

# Third-party game content is never tracked. dodge.p8.png is the cartridge
# you supply; dodge.lua and dodge.p8 are generated from it by
# tools/extract_cart.py and can be regenerated at any time.
dodge.p8.png
logic.js
dodge.lua
dodge.p8
dodge.rom

# Reward weights are per-user tuning state. Defaults live in
# dodge/rewards.py, and a missing file simply uses them.
rewards.json

# The Game Config panel's settings, likewise per-user. Defaults live in
# dodge/game_settings.py, and a missing file simply uses them.
game-config.json

# Brainstorm and plan-execution scratch from the superpowers tools.
.superpowers/

# The Training panel's schedule, likewise per-user. Defaults live in
# dodge/schedule.py, and a missing file simply uses them.
training.json

# Outputs: videos and saved runs from watch_heuristic.py/render_run.py, and
# reports exported at the top level.
recordings/
/*.pdf

# Claude Code's per-user settings and its worktrees.
.claude/settings.local.json
.claude/worktrees/
